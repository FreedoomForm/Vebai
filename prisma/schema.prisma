generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// One video-generation request fed to the Kaggle H3 pipeline.
// status: queued | generating | complete | failed
model Job {
  id             String   @id @default(cuid())
  prompt         String
  seconds        Int      @default(5)
  frameOrigData  Bytes? // original uploaded first-frame image (for reference/re-prep)
  framePrepped   Bytes? // 864x480 canvas version actually shipped to Kaggle
  status         String   @default("queued")
  batchId        String? // Kaggle kernel session that processes this job
  shotNum        Int? // shot_NN index inside the batch
  videoData      Bytes? // finished mp4 delivered from Kaggle (served via /api/video)
  error          String?
  testMode       Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([status])
  @@index([batchId])
}

// Site user. Registration is gated by Z.ai's own server captcha (the same
// Aliyun slider widget chat.z.ai uses — relayed to the user, solved by the
// user, verified by chat.z.ai). We never collect Z.ai tokens and never ask
// for the owner's JWT: each user gets their own anonymous Z.ai session whose
// quota is consumed by Z.ai. AI requests are proxied through chat.z.ai
// (see src/lib/chatweb.ts).
model User {
  id            String         @id @default(cuid())
  email         String         @unique
  passwordHash  String
  name          String         @default("")
  zaiToken      String? // anonymous chat.z.ai session token minted for this user
  zaiUserId     String? // chat.z.ai session user id (for the signature)
  zaiSessionAt  DateTime? // when the session was last (re)minted
  telegramChatId  String?  @unique // telegram user id when linked (mini app / bot)
  telegramUsername String? // @username from telegram (display only)
  createdAt     DateTime       @default(now())
  conversations Conversation[]
  tgAccounts    TgAccount[]
}

// ---------------------------------------------------------------------------
// T26: personal Telegram agents. A user connects HIS OWN Telegram account
// (phone + code, MTProto user session - NOT the bot), explains the rules in a
// chat with the site AI, approves reply variants, and the resident worker
// (GitHub Actions shift) then answers incoming private messages on his behalf.
model TgAccount {
  id              String    @id @default(cuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  phone           String
  apiId           Int // MTProto app id (env-provided or user's own from my.telegram.org)
  apiHashEnc      String // encrypted api_hash (AES-256-GCM)
  sessionEnc      String? // encrypted GramJS StringSession (auth keys) - secrets at rest
  phoneCodeHash   String? // transient login state between /connect and /verify
  loginSessionEnc String? // encrypted session created during sendCode (must match at signIn)
  status          String    @default("pending") // pending | 2fa | connected | error
  statusText      String? // last human-readable status / honest error
  meInfo          String? // JSON {id, firstName, username, phone}
  active          Boolean   @default(false) // auto-reply master switch
  lastCheckAt     DateTime? // last worker poll that included this account
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  config   TgAgentConfig?
  messages TgAgentMessage[]

  @@unique([userId, phone])
  @@index([status, active])
}

// The system prompt + few-shot examples that drive the user's personal agent.
// Maintained conversationally: the site AI rewrites it from the owner's rules,
// the owner can edit it by hand, approved test variants become examples.
model TgAgentConfig {
  id           String    @id @default(cuid())
  accountId    String    @unique
  account      TgAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  systemPrompt String    @default("")
  examples     String    @default("[]") // JSON [{from, incoming, reply, at}]
  updatedAt    DateTime  @updatedAt
}

// Message log (incoming requests + replies actually sent). Dedupe key for
// the worker is (account, chat, msgId, direction).
model TgAgentMessage {
  id        String    @id @default(cuid())
  accountId String
  account   TgAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  chatId    String
  chatName  String?
  msgId     String
  direction String // in | out
  text      String
  createdAt DateTime  @default(now())

  @@unique([accountId, chatId, msgId, direction])
  @@index([accountId, createdAt])
}

// A chat thread with the persistent AI architect (Manus-style agent)
model Conversation {
  id        String      @id @default(cuid())
  userId    String?
  user      User?       @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String      @default("Новый диалог")
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  messages  Message[]
  tasks     AgentTask[]

  @@index([updatedAt])
  @@index([userId])
}

// One chat message. kind: text | task_result
// meta (JSON string): { tools: [{name,args,status,result}], plan: {steps:[{title,status}]}, artifacts: [{kind,url,title}] }
model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           String // user | assistant
  kind           String       @default("text")
  content        String
  meta           String?
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
}

// A background job the agent launched (image gen, video batch, research...)
// status: queued | running | completed | failed
model AgentTask {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  type           String // image | video
  title          String
  status         String       @default("queued")
  progress       String? // human-readable live step ("Кадр 2/6: генерация")
  payload        String? // JSON: {shots:[{title,h3_prompt,seconds,firstFrameTaskId?}], testMode, size...}
  result         String? // JSON: {artifacts:[{kind,url,title}], summary}
  error          String?
  jobIds         String? // JSON: [Job.id, ...] created for video tasks
  imageData      Bytes? // generated PNG for image tasks (served via /api/image)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([conversationId])
  @@index([status])
}

// Key/value store replacing the old studio-state.json file
// (Vercel lambdas have an ephemeral filesystem).
model StudioState {
  key       String   @id
  data      String // JSON of StudioState shape
  updatedAt DateTime @updatedAt
}

// Browser terminal (v86 in-tab VM) session. The VM itself lives in the
// user's browser; the DB keeps the queue, the files and the session secret
// so the agent (Vercel) and the page can cooperate and resume work.
model TerminalSession {
  id         String   @id @default(cuid())
  userId     String?
  kind       String   @default("browser") // browser | kaggle
  title      String   @default("")
  status     String   @default("active") // active | archived
  secret     String // random hex; guest scripts use it to upload files
  lastSeenAt DateTime? // page heartbeat: VM alive in some browser tab
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  commands   TerminalCommand[]
  files      TerminalFile[]

  @@index([userId, status])
}

// One queued command for a TerminalSession. The browser page polls pending
// commands, types them into the VM and posts the captured output back.
model TerminalCommand {
  id             String          @id @default(cuid())
  sessionId      String
  session        TerminalSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  conversationId String? // when set, the result is posted back to this chat
  command        String
  status         String          @default("pending") // pending | running | done | failed
  output         String?
  exitCode       Int?
  source         String          @default("agent") // agent | user
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([sessionId, status])
}

// Files produced inside the browser VM (synced by the guest daemon).
// Small files are kept in Postgres for restore; everything is mirrored to
// the owner's Telegram channel with the terminal id in the caption.
model TerminalFile {
  id        String          @id @default(cuid())
  sessionId String
  session   TerminalSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  conversationId String? // when set: file belongs to this chat (per-user listing)
  path      String
  size      Int             @default(0)
  mime      String?
  data      Bytes? // only for files <= 3.5MB (restore without Telegram)
  tgOk      Boolean         @default(false)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@unique([sessionId, path])
}
