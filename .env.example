# ---------------------------------------------------------------------------
# Vebai — environment template. Copy the values into Vercel → Settings →
# Environment Variables (or .env.local for local dev). Never commit real keys.
# ---------------------------------------------------------------------------

# Postgres connection string (Vercel Postgres / Neon / Supabase...).
# Create the schema once with: npx prisma db push
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# ---------------------------------------------------------------------------
# Official Z.ai / Zhipu OpenAI-compatible API (server-side only).
# Get the key at https://z.ai (model API) or https://open.bigmodel.cn.
# All chat runs on FREE models — glm-4.7-flash (default) with an automatic
# fallback to glm-4.5-flash when overloaded. No user logins with Z.ai.
ZAI_API_KEY=
# Base URL: https://open.bigmodel.cn/api/paas/v4 (mainland, has glm-4.7-flash)
# or https://api.z.ai/api/paas/v4 (international, glm-4.5-flash free tier)
ZAI_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# Primary chat model (free): glm-4.7-flash | glm-4.5-flash
ZAI_MODEL=glm-4.7-flash
# Free image generation model (CogView-3-Flash)
ZAI_IMAGE_MODEL=cogview-3-flash

# ---------------------------------------------------------------------------
# Kaggle (video pipeline: H3 worker kernels + job/output datasets)
# Token from kaggle.com → Settings → API → Create New Token.
KAGGLE_API_TOKEN=
KAGGLE_ACCOUNT=freedomform

# ---------------------------------------------------------------------------
# Auth & misc
# 'false' disables the login/registration gate (single-user / self-host mode).
AUTH_REQUIRED=
# Secret for signing session cookies. Optional but recommended in production;
# falls back to a hash of DATABASE_URL when unset.
APP_SECRET=

# Optional: protect /api/agent/tick when using an external pinger
CRON_SECRET=

# Optional: '1' enables the socket.io transport (self-hosted relay on :3003).
# Leave unset on Vercel — the HTTP polling transport is used instead.
NEXT_PUBLIC_ENABLE_SOCKET=
