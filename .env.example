# ---------------------------------------------------------------------------
# Vebai — environment template. Copy the values into Vercel → Settings →
# Environment Variables (or .env.local for local dev). Never commit real keys.
# ---------------------------------------------------------------------------

# Postgres connection string (Vercel Postgres / Neon / Supabase...).
# Create the schema once with: npx prisma db push
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# ---------------------------------------------------------------------------
# Z.ai chat proxy (default LLM backend)
#
# The site talks to chat.z.ai using its web protocol (src/lib/chatweb.ts).
# Credentials chain: user's own token (settings) -> ZAI_JWT -> guest session.
#
# ZAI_JWT — the token of a REAL chat.z.ai account (recommended). How to get it:
#   1. Log in at https://chat.z.ai in your browser.
#   2. DevTools (F12) → Application → Local Storage → https://chat.z.ai
#   3. Copy the value of the "token" key and paste it here.
# Without ZAI_JWT the site falls back to anonymous guest sessions, which
# chat.z.ai gates behind a captcha — so set ZAI_JWT for stable operation.
ZAI_JWT=

# Model used through the chat.z.ai proxy (see /api/models for the live list):
#   glm-5.3 | glm-5.2 | GLM-5-Turbo | x-preview-l (GLM-5.3-Flash) | glm-4.7
#   0727-360B-API (GLM-4.5, the "agent" model) | 0727-106B-API (GLM-4.5-Air)
ZAI_CHATWEB_MODEL=glm-4.7

# Optional: alternate web-protocol base (leave unset for https://chat.z.ai)
ZAI_CHATWEB_BASE_URL=

# ---------------------------------------------------------------------------
# Official Z.ai platform API (optional, paid) — enables image generation
# (CogView) and better search. Set ZAI_MODE=official to also route chat here.
ZAI_MODE=
ZAI_BASE_URL=https://api.z.ai/api/paas/v4
ZAI_API_KEY=
ZAI_TOKEN=
ZAI_CHAT_ID=
ZAI_USER_ID=

# ---------------------------------------------------------------------------
# Kaggle (video pipeline: H3 worker kernels + job/output datasets)
# Token from kaggle.com → Settings → API → Create New Token.
KAGGLE_API_TOKEN=
KAGGLE_ACCOUNT=freedomform

# ---------------------------------------------------------------------------
# Auth & misc
# 'false' disables the login/registration gate (single-user / self-host mode).
AUTH_REQUIRED=
# Secret for signing session cookies. Optional but recommended in production;
# falls back to a hash of DATABASE_URL when unset.
APP_SECRET=

# Optional: protect /api/agent/tick when using an external pinger
CRON_SECRET=

# Optional: '1' enables the socket.io transport (self-hosted relay on :3003).
# Leave unset on Vercel — the HTTP polling transport is used instead.
NEXT_PUBLIC_ENABLE_SOCKET=
